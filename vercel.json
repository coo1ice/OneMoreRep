{
  "cleanUrls": true,
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/out",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
